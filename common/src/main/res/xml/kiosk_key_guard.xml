<?xml version="1.0" encoding="utf-8"?>
<!-- KIDS v1.6: config for KioskKeyGuardService. The service needs NO window
     content and NO event types — only the global key filter, which is what
     blocks HOME / RECENTS / mic system-wide while kiosk mode is on. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="18"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:notificationTimeout="100"
    android:description="@string/kids_kiosk_key_guard_desc" />
