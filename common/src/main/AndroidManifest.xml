<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
          package="com.liskovsoft.smartyoutubetv2.common">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14 (API 34): the kiosk watchdog is a foreground service, and the
         shipped flavors target 34 — without a declared type startForeground()
         throws MissingForegroundServiceTypeException and the watchdog (kiosk
         layer 3) silently stopped itself on Android TV 14. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 14 (API 34) -->
    <!-- <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" /> -->
    <!-- API level 34 -->
    <!-- <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" /> -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.QUICKBOOT_POWERON" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <!-- Android 10 and up. Start from background permission. Settings/Apps/Draw over other apps (disabled by default) -->
    <!-- https://developer.android.com/guide/components/activities/background-starts -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.ACTION_MANAGE_OVERLAY_PERMISSION" />
    <!-- <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" /> -->
    <!-- Android 9+: needed to run package uninstaller (ATV, Amazon bride) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES"/>
    <!-- Starting targetSDK 33+, foreground services require explicit permissions in the manifest. -->
    <!-- NOTE: only works with 'mediaPlayback' type service. Others types will fail. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>

    <queries>
        <!-- Android 11+: access package info (works only for specified apps) -->
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.amazon.firetv.youtube" />
        <!-- Android 11+: access the main icon (works for all apps) -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
        </intent>
    </queries>

    <!-- Add requestLegacyExternalStorage to fix unavailable storage on Android 10 (doesn't work on Android 11) -->
    <!-- More info: https://stackoverflow.com/questions/63364476/requestlegacyexternalstorage-is-not-working-in-android-11-api-30 -->
    <application android:requestLegacyExternalStorage="true">
        <receiver
            android:name="com.liskovsoft.smartyoutubetv2.common.misc.RemoteControlReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.SCREEN_ON" />
                <!-- For HTC devices -->
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <!-- Fix: Permission Denial: not allowed to send broadcast android.intent.action.BOOT_COMPLETED -->
                <action android:name="android.intent.action.ACTION_BOOT_COMPLETED" />
                <!-- Autostart fix on some devices? -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- Nvidia Shield autostart fix? -->
                <action android:name="android.intent.action.REBOOT" />
                <action android:name="android.intent.action.ACTION_SHUTDOWN" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
            </intent-filter>
        </receiver>
        <!-- KIDS: device admin receiver for kiosk mode (Lock Task).
             Becomes useful when the app is set as device owner via ADB (see KIOSK.md):
             adb shell dpm set-device-owner <applicationId>/com.liskovsoft.smartyoutubetv2.common.misc.KioskDeviceAdminReceiver -->
        <receiver
            android:name="com.liskovsoft.smartyoutubetv2.common.misc.KioskDeviceAdminReceiver"
            android:label="@string/kids_kiosk_mode"
            android:description="@string/kids_kiosk_mode_desc"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/kids_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <!-- NOTE: Starting from Android 12 (api 31) foreground service with type 'connectedDevice' not supported -->
        <!-- Use 'mediaPlayback' type instead -->
        <service
            android:name="com.liskovsoft.smartyoutubetv2.common.misc.RemoteControlService"
            android:enabled="true"
            android:foregroundServiceType="mediaPlayback"/>
        <service
            android:name="com.liskovsoft.smartyoutubetv2.common.misc.BackgroundPlaybackService"
            android:enabled="true"/>
        <!-- KIDS v1.4: kiosk soft-lock guardian. While kiosk is ON without Device
             Owner and the app is off screen, this service relaunches it every second
             and (when allowed) covers the launcher with a fullscreen overlay until
             SmartTubeKids is back on top. SYSTEM_ALERT_WINDOW is auto-granted on
             Android TV at install time. -->
        <service
            android:name="com.liskovsoft.smartyoutubetv2.common.misc.KioskWatchdogService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- The subtype property is what Android 14 asks for when a service
                 declares specialUse; the two-argument startForeground() in
                 KioskWatchdogService.onCreate then resolves the type from here. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="parental-control watchdog: keeps the locked kids app on screen"
                tools:targetApi="31" />
        </service>
        <!-- KIDS v1.6: kiosk key guard. Accessibility input filter that blocks
             HOME / RECENTS / mic (SEARCH-ASSIST) system-wide while kiosk is ON —
             the only way to lock a TV without Device Owner (screen pinning is
             silently disabled on many Android TV 14 builds). Enabled by the
             parent from Kids Mode settings (KioskModeManager.startKeyGuardSetup)
             or via ADB (see KIOSK.md). Inert when kiosk is OFF. -->
        <service
            android:name="com.liskovsoft.smartyoutubetv2.common.misc.KioskKeyGuardService"
            android:label="@string/kids_kiosk_key_guard_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:enabled="true"
            android:exported="true">
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/kiosk_key_guard" />
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
        </service>

        <activity android:name=".misc.BackupReceiverActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Fixes lint AppLinkUrlError -->
                <data android:scheme="content" android:mimeType="application/zip" />
                <data android:scheme="file" android:mimeType="application/zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
            </intent-filter>
        </activity>
    </application>
</manifest>
